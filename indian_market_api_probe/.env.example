# Copy this file to .env and fill in credentials locally.
# NEVER commit .env or paste keys/secrets into chat.

# ---------- GROWW ----------
# Option A: paste the daily access token generated in Groww > Settings > Trading APIs
GROWW_ACCESS_TOKEN=

# Option B: key/secret flow (may require daily approval in Groww Cloud API Keys page)
GROWW_API_KEY=
GROWW_API_SECRET=

# ---------- ICICI DIRECT BREEZE ----------
# Create an app at https://api.icicidirect.com/apiuser/home
BREEZE_API_KEY=
BREEZE_API_SECRET=
# API_Session value from the browser redirect after Breeze login (not password/TOTP)
BREEZE_API_SESSION=
# Optional for Candle Stream; resolve codes from StockScriptNew.csv
# Example format only: 4.1!1594
BREEZE_SCRIPT_CODES=
# Supported by documented Candle Stream: 1SEC, 1MIN, 5MIN, 30MIN
BREEZE_CHANNEL=1SEC

# ---------- UPSTOX ----------
# Recommended: free read-only Analytics Token (1-year validity)
UPSTOX_ANALYTICS_TOKEN=
# Alternative environment variable name if using a different read-only access token
UPSTOX_ACCESS_TOKEN=
# Exact Upstox instrument keys; defaults are Reliance equity and Nifty 50 index
UPSTOX_INSTRUMENT_KEYS=
